# Copy this file to .env and fill in the keys you need.
# Nothing here is required to run the offline tests.

# Hugging Face (needed to download / publish datasets and the fine-tuned adapter)
HF_TOKEN=
# Where datasets and models are read from / written to on the Hugging Face Hub.
# DATA_HF_USER: owner of the items_* datasets you load.
# MY_HF_USER:   your own account, used when you push new datasets or adapters.
DATA_HF_USER=ed-donner
MY_HF_USER=
LITE_MODE=true

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Models
FRONTIER_MODEL=gpt-5.1
SCANNER_MODEL=gpt-5-mini
PREPROCESSOR_MODEL=ollama/llama3.2

# Push notifications (optional)
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Paths
ARTIFACTS_DIR=artifacts
VECTORSTORE_DIR=products_vectorstore
